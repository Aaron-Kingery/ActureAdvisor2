# Database
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=acture_advisor
DATABASE_URL=postgresql+asyncpg://user:password@db:5432/acture_advisor

# Core AI
OLLAMA_BASE_URL=http://ollama:11434

# Hybrid LLM (Optional - Required for OpenAI)
OPENAI_API_KEY=

# Document Connectors (SharePoint)
# Ensure your Azure App has Sites.Read.All permissions
SHAREPOINT_SITE_URL=https://nessnetworks0.sharepoint.com/sites/Documentation
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# Document Connectors (Google Drive)
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_APPLICATION_CREDENTIALS=/app/google_credentials.json

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000"]
